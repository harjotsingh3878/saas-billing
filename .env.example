# AWS Configuration
AWS_REGION=us-east-1
AWS_ACCOUNT_ID=your-account-id

# DynamoDB (local)
DYNAMODB_ENDPOINT=http://localhost:8000

# Kafka (local)
KAFKA_BROKERS=localhost:9092

# AWS Services (production)
EVENTBRIDGE_BUS_NAME=saas-billing-events
S3_INVOICES_BUCKET=saas-invoices
SES_FROM_EMAIL=billing@yourdomain.com

# Cognito
COGNITO_USER_POOL_ID=your-user-pool-id
COGNITO_CLIENT_ID=your-client-id
COGNITO_REGION=us-east-1

# Service URLs
GATEWAY_URL=http://localhost:4000
TENANT_SERVICE_URL=http://localhost:4001
SUBSCRIPTION_SERVICE_URL=http://localhost:4002
USAGE_SERVICE_URL=http://localhost:4003
BILLING_SERVICE_URL=http://localhost:4004

# Next.js
NEXT_PUBLIC_API_URL=http://localhost:4000/graphql
NEXT_PUBLIC_COGNITO_USER_POOL_ID=your-user-pool-id
NEXT_PUBLIC_COGNITO_CLIENT_ID=your-client-id
